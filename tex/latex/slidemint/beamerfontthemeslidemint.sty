\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{beamerfontthemeslidemint}[2026-05-25 v0.1.0 Slidemint font theme]

% The text and math fonts, in a package of their own so that figures share them.
\RequirePackage{slidemintfonts}

% The title, code, and quote families belong to the theme.
\newfontfamily{\slidemint@titlefamily}[
    Scale=MatchUppercase,
    ItalicFont={Plus Jakarta Sans Italic},
    BoldFont={Plus Jakarta Sans},
    BoldFeatures={Weight=700},
    BoldItalicFont={Plus Jakarta Sans Italic},
    BoldItalicFeatures={Weight=700},
]{Plus Jakarta Sans}

\newfontfamily{\slidemint@codefamily}[
    ItalicFont={MesloLGS NF Italic},
    BoldFont={MesloLGS NF Bold},
    BoldItalicFont={MesloLGS NF Bold Italic},
    Ligatures=NoCommon,
]{MesloLGS NF}

\newfontfamily{\slidemint@quotefamily}[
    Weight=500,
    ItalicFont={Plus Jakarta Sans Italic},
    ItalicFeatures={Weight=500},
    BoldFont={Plus Jakarta Sans},
    BoldFeatures={Weight=700},
    BoldItalicFont={Plus Jakarta Sans Italic},
    BoldItalicFeatures={Weight=700},
]{Plus Jakarta Sans}

\newcommand*{\SlidemintCodeFont}{\slidemint@codefamily\fontsize{9.75pt}{15pt}\selectfont}

\setbeamerfont{title}{family=\slidemint@titlefamily,series=\mdseries}
\setbeamerfont{subtitle}{parent=title,series=\mdseries}
\setbeamerfont{author}{parent=subtitle,series=\mdseries}
\setbeamerfont{institute}{parent=subtitle,series=\mdseries}
\setbeamerfont{date}{parent=subtitle,series=\mdseries}

% Block environments
\setbeamerfont{block body}{}
\setbeamerfont{block body alerted}{parent=block body}
\setbeamerfont{block body example}{parent=block body}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries,parent={structure,block body}}
\setbeamerfont{block title alerted}{parent={block title,alerted text}}
\setbeamerfont{block title example}{parent={block title,example text}}

% Verse, quotations, quotes
\setbeamerfont{quotation}{family=\slidemint@quotefamily}
\setbeamerfont{quote}{family=\slidemint@quotefamily}

% Bibliography
\setbeamerfont{bibliography item}{size=\footnotesize}
\setbeamerfont{bibliography entry author}{size=\footnotesize,series=\mdseries}
\setbeamerfont{bibliography entry title}{size=\footnotesize,series=\mdseries}
\setbeamerfont{bibliography entry location}{size=\footnotesize,series=\mdseries}
\setbeamerfont{bibliography entry note}{size=\footnotesize,series=\mdseries}
