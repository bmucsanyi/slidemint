\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{beamerthemeslidemint}[2026-11-11 v0.2.0 Beamer theme for visual slide decks]

\RequirePackage{iftex}
\ifLuaTeX
\else
    \PackageError{slidemint}{Slidemint requires LuaLaTeX}{Compile with lualatex.}%
\fi

% The one option, the palette, through the kernel's key-value interface, which
% stops on an option the theme does not declare; Beamer's own would ignore it.
\newcommand*{\slidemint@palette}{latte}
\DeclareKeys[slidemint]{palette.store = \slidemint@palette}
\ProcessKeyOptions[slidemint]

\RequirePackage[backend=biber,style=authoryear,natbib=true,sorting=none,maxcitenames=99]{biblatex}

% Footer citations. \citef{key,...} works like \citep but renders the cited
% bib entries in the footer instead of inline: one biblatex-formatted line per
% key. Multiple keys or multiple \citef on a frame stack as separate footer
% lines and replace the footer-left text; the slide number is still shown. The
% footline template renders the collected keys through \slidemint@footcite and
% clears them after each slide, which keeps the behaviour correct across
% overlays and leaves decks that never call \citef unaffected.
\newcommand*{\slidemint@citekeys}{}
\newcommand{\citef}[1]{%
    \ifx\slidemint@citekeys\@empty\else
        \g@addto@macro\slidemint@citekeys{,}%
    \fi
    \g@addto@macro\slidemint@citekeys{#1}%
}

% Footer citation format: "Title. Authors. Venue, Year." pulled from the cited
% bib entry. \slidemint@footcite loops over keys and puts each on its own line;
% the footline template calls it with the keys collected by \citef. The venue
% falls back across the common entry-type fields.
% Uniform venue: plain text for every entry type (booktitle/journaltitle are
% italic by default, note/publisher are not; this removes that inconsistency).
\DeclareFieldFormat{slidemint:venuefield}{#1}
\newbibmacro*{slidemint:venue}{%
    \iffieldundef{journaltitle}
        {\iffieldundef{booktitle}
            {\iffieldundef{eventtitle}
                {\iflistundef{publisher}
                    {\printfield{note}}
                    {\printlist{publisher}}}
                {\printfield{eventtitle}}}
            {\printfield[slidemint:venuefield]{booktitle}}}
        {\printfield[slidemint:venuefield]{journaltitle}}%
}
% Family name to boldface in footer citations (e.g. the presenter's own name),
% set via \slidemintsetup{cite-highlight = {...}}; empty means no highlighting.
\newcommand*{\slidemint@boldfamily}{}
% Joint-first authors carry a star in the footer name list, marked in the bib
% with author+an = {1=equal;2=equal}. Inert for entries without the annotation.
% The asterisk glyph already sits high, so it takes a gentle raise, not a full
% \textsuperscript.
\newcommand*{\slidemint@equalmark}{$^*$}
% Uniform title: italic for every entry type, never quoted.
\DeclareFieldFormat{slidemint:title}{\textit{#1}}
% Boldface the highlighted family name through the complete-name hook. It fires
% inside name:family but after the inter-name delimiter is printed, so the comma
% before the name stays upright; wrapping name:family directly would bold that
% leading comma. The hook is used only by the family-only name:family macro.
\renewcommand*{\mkbibcompletenamefamily}[1]{%
    \ifboolexpr{ not test {\ifdefempty{\slidemint@boldfamily}}
                 and test {\ifdefstrequal{\namepartfamily}{\slidemint@boldfamily}} }
        {\mkbibbold{#1}}
        {#1}%
}
\DeclareNameFormat{slidemint:family}{%
    \usebibmacro{name:family}
        {\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}%
    \ifitemannotation{equal}{\slidemint@equalmark}{}%
    \usebibmacro{name:andothers}%
}
% Punctuation-aware units so a trailing "et al." does not double the period.
\newbibmacro*{slidemint:footcite}{%
    \printfield[slidemint:title]{title}%
    \setunit*{\addperiod\space}%
    \printnames[slidemint:family]{author}%
    \setunit*{\addperiod\space}%
    \usebibmacro{slidemint:venue}%
    \setunit*{\addcomma\space}%
    \printfield{year}%
    \adddot%
}
\DeclareCiteCommand{\slidemint@footcite}
    {}
    {\usebibmacro{slidemint:footcite}}
    {\newline}
    {}

\usefonttheme{slidemint}
\usecolortheme{slidemint}
\useinnertheme{slidemint}
\useoutertheme{slidemint}

\newcommand*{\slidemint@footerleft}{}
\DeclareKeys[slidemint/setup]{
    footer-left.store = \slidemint@footerleft,
    cite-highlight.store = \slidemint@boldfamily,
}
\newcommand*{\slidemintsetup}[1]{\SetKeys[slidemint/setup]{#1}}

% figmint follows the palette and draws the figures of a deck at this ratio: a
% figure of full width is then 218bp tall, which a frame with a title has room
% for. The kernel runs the hook at once when figmint is already loaded.
\AddToHook{package/figmint/after}{%
    \expandafter\figmintsettheme\expandafter{\slidemint@flavor}%
    \figmintset{height to width ratio=0.48}%
}

\renewcommand{\maketitle}{%
    \ifbeamer@inframe
        \titlepage%
    \else
        \begin{frame}[plain]
            \titlepage%
        \end{frame}%
    \fi
}

\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=SlidemintLink,
    citecolor=SlidemintLink,
    urlcolor=SlidemintExternalLink,
    filecolor=SlidemintExternalLink}

% Colored emphasis. Strong text inside emphasized text, and the reverse, take
% the strong emphasis color.
\newif\ifslidemint@insidestrong
\newif\ifslidemint@insideemphasis

\NewDocumentCommand \SlidemintTextbf { m } {%
    {%
        \ifslidemint@insideemphasis
            \color{SlidemintStrongEmphasis}%
        \else
            \color{SlidemintStrong}%
        \fi
        \slidemint@insidestrongtrue
        \textbf{#1}%
    }%
}

\newcommand*{\slidemint@emphasis}[1]{%
    {%
        \ifslidemint@insidestrong
            \color{SlidemintStrongEmphasis}%
        \else
            \color{SlidemintEmphasis}%
        \fi
        \slidemint@insideemphasistrue
        #1%
    }%
}
\NewDocumentCommand \SlidemintTextit { m } {\slidemint@emphasis{\textit{#1}}}
\NewDocumentCommand \SlidemintEmph { m } {\slidemint@emphasis{\emph{#1}}}
