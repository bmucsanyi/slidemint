\newcommand*{\SlidemintApplyFigmintStyle}{%
    \@ifpackageloaded{figmint}{%
        \figmintsettheme{\slidemintfigminttheme}%
        \figmintset{height to width ratio=0.5625}%
    }{}%
}

\useinnertheme{slidemint}
\useoutertheme{slidemint}
\AddToHook{package/figmint/after}{\SlidemintApplyFigmintStyle}
\SlidemintApplyFigmintStyle

\renewcommand{\maketitle}{%
    \ifbeamer@inframe
        \titlepage%
    \else
        \begin{frame}[plain]
            \titlepage%
        \end{frame}%
    \fi
}

\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=SlidemintLink,
    citecolor=SlidemintLink,
    urlcolor=SlidemintExternalLink,
    filecolor=SlidemintExternalLink}

\newif\ifSlidemintInsideStrong%
\newif\ifSlidemintInsideEmphasis%

\NewDocumentCommand \SlidemintTextbf { m } {%
    {%
        \ifSlidemintInsideEmphasis%
            \color{SlidemintStrongEmphasis}%
        \else
            \color{SlidemintStrong}%
        \fi
        \SlidemintInsideStrongtrue%
        \textbf{#1}%
    }%
}

\NewDocumentCommand \SlidemintTextit { m } {%
    {%
        \ifSlidemintInsideStrong%
            \color{SlidemintStrongEmphasis}%
        \else
            \color{SlidemintEmphasis}%
        \fi
        \SlidemintInsideEmphasistrue%
        \textit{#1}%
    }%
}

\NewDocumentCommand \SlidemintEmph { m } {%
    {%
        \ifSlidemintInsideStrong%
            \color{SlidemintStrongEmphasis}%
        \else
            \color{SlidemintEmphasis}%
        \fi
        \SlidemintInsideEmphasistrue%
        \emph{#1}%
    }%
}
