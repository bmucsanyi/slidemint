\newif\ifSlidemintDarkMode%
\newcommand*{\SlidemintApplyPalette}{\SlidemintLatteColors}
\newcommand*{\SlidemintUseLatteMintedStyle}{\setminted{style=catppuccin-latte}}
\newcommand*{\SlidemintUseFrappeMintedStyle}{\setminted{style=catppuccin-frappe}}
\newcommand*{\SlidemintUseMacchiatoMintedStyle}{\setminted{style=catppuccin-macchiato}}
\newcommand*{\SlidemintUseMochaMintedStyle}{\setminted{style=catppuccin-mocha}}
\newcommand*{\SlidemintApplyMintedStyle}{\SlidemintUseLatteMintedStyle}
\newcommand*{\slidemintfigminttheme}{latte}
\newcommand*{\slidemintfooterleft}{}

% Footer citations. \citef{key,...} works like \citep but renders the cited
% bib entries in the footer instead of inline: one biblatex-formatted line per
% key. Multiple keys or multiple \citef on a frame stack as separate footer
% lines and replace the footer-left text; the slide number is still shown. The
% footline template renders the collected keys through \slidemintfootcite and
% clears them after each slide, which keeps the behaviour correct across
% overlays and leaves decks that never call \citef unaffected.
\newcommand*{\slidemint@citekeys}{}
\newcommand{\citef}[1]{%
    \ifx\slidemint@citekeys\@empty\else
        \g@addto@macro\slidemint@citekeys{,}%
    \fi
    \g@addto@macro\slidemint@citekeys{#1}%
}

\ExplSyntaxOn
\tl_new:N \l_slidemint_theme_palette_tl
\cs_new_protected:Npn \slidemint_theme_select_palette:n #1
  {
    \tl_set:Nn \l_slidemint_theme_palette_tl {#1}
    \tl_remove_all:Nn \l_slidemint_theme_palette_tl { ~ }
    \str_case:VnF \l_slidemint_theme_palette_tl
      {
        { latte }
          {
            \cs_gset:Npn \slidemintfigminttheme { latte }
            \cs_gset_protected:Npn \SlidemintApplyPalette { \SlidemintLatteColors }
            \cs_gset_eq:NN \SlidemintApplyMintedStyle \SlidemintUseLatteMintedStyle
            \SlidemintDarkModefalse
          }
        { minimalist }
          {
            \cs_gset:Npn \slidemintfigminttheme { latte }
            \cs_gset_protected:Npn \SlidemintApplyPalette { \SlidemintMinimalistColors }
            \cs_gset_eq:NN \SlidemintApplyMintedStyle \SlidemintUseLatteMintedStyle
            \SlidemintDarkModefalse
          }
        { frappe }
          {
            \cs_gset:Npn \slidemintfigminttheme { frappe }
            \cs_gset_protected:Npn \SlidemintApplyPalette { \SlidemintFrappeColors }
            \cs_gset_eq:NN \SlidemintApplyMintedStyle \SlidemintUseFrappeMintedStyle
            \SlidemintDarkModetrue
          }
        { macchiato }
          {
            \cs_gset:Npn \slidemintfigminttheme { macchiato }
            \cs_gset_protected:Npn \SlidemintApplyPalette { \SlidemintMacchiatoColors }
            \cs_gset_eq:NN \SlidemintApplyMintedStyle \SlidemintUseMacchiatoMintedStyle
            \SlidemintDarkModetrue
          }
        { mocha }
          {
            \cs_gset:Npn \slidemintfigminttheme { mocha }
            \cs_gset_protected:Npn \SlidemintApplyPalette { \SlidemintMochaColors }
            \cs_gset_eq:NN \SlidemintApplyMintedStyle \SlidemintUseMochaMintedStyle
            \SlidemintDarkModetrue
          }
      }
      {
        \PackageError { slidemint } { Unknown~palette~'#1' } { Use~latte,~frappe,~macchiato,~mocha,~or~minimalist. }
      }
  }
\NewDocumentCommand \SlidemintSelectPalette { m }
  { \slidemint_theme_select_palette:n {#1} }
\ExplSyntaxOff

\DeclareOptionBeamer{palette}{\SlidemintSelectPalette{#1}}
\DeclareOptionBeamer{latte}{\SlidemintSelectPalette{latte}}
\DeclareOptionBeamer{minimalist}{\SlidemintSelectPalette{minimalist}}
\DeclareOptionBeamer{frappe}{\SlidemintSelectPalette{frappe}}
\DeclareOptionBeamer{macchiato}{\SlidemintSelectPalette{macchiato}}
\DeclareOptionBeamer{mocha}{\SlidemintSelectPalette{mocha}}
