\RequirePackage[backend=biber,style=authoryear,natbib=true,sorting=none,maxcitenames=99]{biblatex}

% Footer citation format: "Title. Authors. Venue, Year." pulled from the cited
% bib entry. \slidemintfootcite loops over keys and puts each on its own line;
% the footline template calls it with the keys collected by \citef. The venue
% falls back across the common entry-type fields.
% Uniform venue: plain text for every entry type (booktitle/journaltitle are
% italic by default, note/publisher are not; this removes that inconsistency).
\DeclareFieldFormat{slidemint:venuefield}{#1}
\newbibmacro*{slidemint:venue}{%
    \iffieldundef{journaltitle}
        {\iffieldundef{booktitle}
            {\iffieldundef{eventtitle}
                {\iflistundef{publisher}
                    {\printfield{note}}
                    {\printlist{publisher}}}
                {\printfield{eventtitle}}}
            {\printfield[slidemint:venuefield]{booktitle}}}
        {\printfield[slidemint:venuefield]{journaltitle}}%
}
% Family name to boldface in footer citations (e.g. the presenter's own name),
% set via \slidemintsetup{cite-highlight = {...}}; empty means no highlighting.
\newcommand*{\slidemint@boldfamily}{}
% Joint-first authors carry a star in the footer name list, marked in the bib
% with author+an = {1=equal;2=equal}. Inert for entries without the annotation.
% The asterisk glyph already sits high, so it takes a gentle raise, not a full
% \textsuperscript.
\newcommand*{\slidemint@equalmark}{$^*$}
% Uniform title: italic for every entry type, never quoted.
\DeclareFieldFormat{slidemint:title}{\textit{#1}}
% Boldface the highlighted family name through the complete-name hook. It fires
% inside name:family but after the inter-name delimiter is printed, so the comma
% before the name stays upright; wrapping name:family directly would bold that
% leading comma. The hook is used only by the family-only name:family macro.
\renewcommand*{\mkbibcompletenamefamily}[1]{%
    \ifboolexpr{ not test {\ifdefempty{\slidemint@boldfamily}}
                 and test {\ifdefstrequal{\namepartfamily}{\slidemint@boldfamily}} }
        {\mkbibbold{#1}}
        {#1}%
}
\DeclareNameFormat{slidemint:family}{%
    \usebibmacro{name:family}
        {\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}%
    \ifitemannotation{equal}{\slidemint@equalmark}{}%
    \usebibmacro{name:andothers}%
}
% Punctuation-aware units so a trailing "et al." does not double the period.
\newbibmacro*{slidemint:footcite}{%
    \printfield[slidemint:title]{title}%
    \setunit*{\addperiod\space}%
    \printnames[slidemint:family]{author}%
    \setunit*{\addperiod\space}%
    \usebibmacro{slidemint:venue}%
    \setunit*{\addcomma\space}%
    \printfield{year}%
    \adddot%
}
\DeclareCiteCommand{\slidemintfootcite}
    {}
    {\usebibmacro{slidemint:footcite}}
    {\newline}
    {}

