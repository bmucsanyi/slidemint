\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{beamerinnerthemeslidemint}[2026-11-11 v0.2.0 Slidemint inner theme]

\RequirePackage[cachedir=_minted-\jobname]{minted}
\RequirePackage{tikz}

\setminted{
    fontsize=\SlidemintCodeFont,
    breaklines,
    autogobble,
    bgcolor=SlidemintCodeBody,
    bgcolorpadding=.75em
}
\setmintedinline{
    bgcolorpadding=0pt
}
% The Pygments style of the palette's flavor.
\begingroup
\edef\slidemint@setmintedstyle{\endgroup\noexpand\setminted{style=\slidemint@mintedstyle}}
\slidemint@setmintedstyle

\newcommand*{\slidemint@listbullet}{%
    \tikz[baseline=-0.55ex]{\fill[SlidemintListMarker] (0,0) circle[radius=0.15em];}%
}
\setbeamertemplate{itemize item}{\slidemint@listbullet}
\setbeamertemplate{itemize subitem}{\slidemint@listbullet}
\setbeamertemplate{itemize subsubitem}{\slidemint@listbullet}

\setbeamertemplate{enumerate item}{\textcolor{SlidemintListMarker}{\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{\textcolor{SlidemintListMarker}{\insertsubenumlabel.}}
\setbeamertemplate{enumerate subsubitem}{\textcolor{SlidemintListMarker}{\insertsubsubenumlabel.}}

\setbeamertemplate{bibliography item}{}
\setbeamertemplate{bibliography entry title}{\space}
\setbeamertemplate{bibliography entry location}{\space}
\setbeamertemplate{bibliography entry note}{\space}

% The block templates of Beamer's default inner theme, with a strut around the
% title: a title with a descender is then as tall as one without, and the
% bodies of blocks side by side start at the same height.
\newcommand*{\slidemint@blockbegin}[2]{%
    \par\vskip\medskipamount%
    \begin{beamercolorbox}[colsep*=.75ex]{#1}
        \usebeamerfont*{#1}\strut\insertblocktitle\strut%
    \end{beamercolorbox}\noframebreak%
    {\parskip0pt\par}%
    \ifbeamercolorempty[bg]{#1}
    {}
    {\ifbeamercolorempty[bg]{#2}{}{\nointerlineskip\vskip-0.5pt}}%
    \usebeamerfont{#2}%
    \begin{beamercolorbox}[colsep*=.75ex,vmode]{#2}%
        \ifbeamercolorempty[bg]{#2}{\vskip-.25ex}{\vskip-.75ex}\vbox{}%
}
\setbeamertemplate{block begin}{\slidemint@blockbegin{block title}{block body}}
\setbeamertemplate{block alerted begin}{\slidemint@blockbegin{block title alerted}{block body alerted}}
\setbeamertemplate{block example begin}{\slidemint@blockbegin{block title example}{block body example}}

% An aligned block is a block whose body is a minipage of a given height, so
% that blocks side by side end at the same height.
\newcommand*{\slidemint@beginalignedblockbody}[1]{%
    \begin{minipage}[t][#1][t]{\linewidth}%
        \setlength{\parindent}{0pt}%
        \ignorespaces%
}
\newcommand*{\slidemint@endalignedblockbody}{%
        \unskip%
    \end{minipage}%
}
\newcommand*{\slidemint@newalignedblock}[2]{%
    \newenvironment{#1}[2]{%
        \begin{#2}{##2}%
        \slidemint@beginalignedblockbody{##1}%
    }{%
        \slidemint@endalignedblockbody%
        \end{#2}%
    }%
}
\slidemint@newalignedblock{alignedblock}{block}
\slidemint@newalignedblock{alignedalertblock}{alertblock}
\slidemint@newalignedblock{alignedexampleblock}{exampleblock}

\newenvironment{ribbon}{\usebeamertemplate{ribbon begin}}{\usebeamertemplate{ribbon end}}
\newcommand*{\slidemint@ribbonlistspacing}{%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\itemsep}{3pt}%
    \def\@listi{\leftmargin\leftmargini\topsep0pt\partopsep0pt\parsep0pt\itemsep3pt}%
    \let\@listI\@listi%
}
\setbeamertemplate{ribbon begin}{%
    \par\vskip\smallskipamount%
    \noindent\begin{beamercolorbox}[wd=\paperwidth,sep=0pt,vmode,leftskip=\beamer@leftmargin,rightskip=\beamer@rightmargin]{ribbon}%
        \vskip.70em%
        \setbeamercolor{structure}{parent=ribbon structure}%
        \setbeamercolor*{item}{parent=ribbon item}%
        \setbeamercolor*{item projected}{parent=ribbon item projected}%
        \setbeamercolor*{alerted text}{parent=ribbon alerted text}%
        \slidemint@ribbonlistspacing%
        \ignorespaces%
}
\setbeamertemplate{ribbon end}{%
        \unskip%
        \vskip.65em%
    \end{beamercolorbox}%
    \vskip\smallskipamount%
}

\defbeamertemplate*{section page}{slidemint}
{
    \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=center] at (current page.center) {%
            \begin{minipage}{\textwidth}%
                \centering
                {\usebeamerfont{title}%
                \hypersetup{linkcolor=SlidemintHeading}\textcolor{SlidemintHeading}{\insertsection}}\par
            \end{minipage}%
        };
    \end{tikzpicture}
}

\defbeamertemplate*{title page}{slidemint}[1][]
{
    \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=center] at (current page.center) {%
            \begin{minipage}{\textwidth}
                \centering
                {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
                \ifx\insertsubtitle\@empty%
                \else%
                    \vskip0.25em%
                    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
                \fi%
                \ifx\insertauthor\@empty%
                \else%
                    \vskip.5em\par
                    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
                \fi%
                \ifx\insertinstitute\@empty%
                \else%
                    \vskip.5em\par
                    {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}%
                    \vskip.3em\par
                \fi%
                \vskip.5em\par
                {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
                \ifx\inserttitlegraphic\@empty%
                \else%
                    \vskip.5em\par
                    {\usebeamercolor[fg]{titlegraphic}\inserttitlegraphic\par}%
                \fi%
            \end{minipage}
        };
    \end{tikzpicture}
}
