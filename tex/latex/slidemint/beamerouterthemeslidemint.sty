\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{beamerouterthemeslidemint}[2026-05-25 v0.1.0 Slidemint outer theme]

\pdfstringdefDisableCommands{\def\translate#1{#1}}

\setbeamertemplate{navigation symbols}{}

\defbeamertemplate*{frametitle}{slidemint}[1][left]
{%
    \ifbeamercolorempty[bg]{frametitle}{}{\nointerlineskip}%
    \@tempdima=\textwidth%
    \advance\@tempdima by\beamer@leftmargin%
    \advance\@tempdima by\beamer@rightmargin%
    \begin{beamercolorbox}[sep=0.3cm,#1,wd=\the\@tempdima]{frametitle}
        \usebeamerfont{frametitle}%
        \vbox{}\vskip-1ex%
        \if@tempswa\else\csname beamer@fte#1\endcsname\fi%
        \parbox{\dimexpr\linewidth-0.6cm\relax}{%
            \strut%
            \insertframetitle%
            \strut%
        }%
        \par%
        {%
            \ifx\insertframesubtitle\@empty%
                \else%
                {%
                    \usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
                    \parbox{\dimexpr\linewidth-0.6cm\relax}{\strut\insertframesubtitle\strut}%
                    \par%
                }%
            \fi
        }%
        \vskip-1ex%
        \if@tempswa\else\vskip-.3cm\fi%
    \end{beamercolorbox}%
}

\setbeamertemplate{frametitle continuation}{}

% One box: on the left the footer text, or the citations of the frame on one
% line each, and on the right the frame number. The footer text stands on a
% strut of 3ex, the height the box has with no citation; with citations the
% box is as tall as they are.
\defbeamertemplate*{footline}{slidemint}
{%
    \ifbeamer@plainframe
        \global\let\slidemint@citekeys\@empty%
    \else
        \begin{beamercolorbox}[wd=\paperwidth,dp=1.5ex,leftskip=.3cm,rightskip=.3cm,sep=0pt]{footline}
            \usebeamercolor[fg]{footline}%
            \ifx\slidemint@citekeys\@empty%
                \vrule height 3ex depth 0pt width 0pt\slidemint@footerleft%
            \else%
                \parbox[b]{\dimexpr\paperwidth-2.2cm\relax}{%
                    \usebeamerfont{footline}%
                    \raggedright\setlength{\parskip}{0pt}%
                    \expandafter\slidemint@footcite\expandafter{\slidemint@citekeys}\par}%
            \fi%
            \hfill%
            \insertframenumber/\inserttotalframenumber%
        \end{beamercolorbox}%
        \global\let\slidemint@citekeys\@empty%
    \fi
}
