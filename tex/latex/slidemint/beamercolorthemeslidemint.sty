\newcommand*{\SlidemintUsePalette}[1]{%
    \colorlet{SlidemintRosewater}{Cat#1Rosewater}%
    \colorlet{SlidemintFlamingo}{Cat#1Flamingo}%
    \colorlet{SlidemintPink}{Cat#1Pink}%
    \colorlet{SlidemintMauve}{Cat#1Mauve}%
    \colorlet{SlidemintRed}{Cat#1Red}%
    \colorlet{SlidemintMaroon}{Cat#1Maroon}%
    \colorlet{SlidemintPeach}{Cat#1Peach}%
    \colorlet{SlidemintYellow}{Cat#1Yellow}%
    \colorlet{SlidemintGreen}{Cat#1Green}%
    \colorlet{SlidemintTeal}{Cat#1Teal}%
    \colorlet{SlidemintSky}{Cat#1Sky}%
    \colorlet{SlidemintSapphire}{Cat#1Sapphire}%
    \colorlet{SlidemintBlue}{Cat#1Blue}%
    \colorlet{SlidemintLavender}{Cat#1Lavender}%
    \colorlet{SlidemintText}{Cat#1Text}%
    \colorlet{SlidemintSubtext}{Cat#1SubtextOne}%
    \colorlet{SlidemintMuted}{Cat#1SubtextZero}%
    \colorlet{SlidemintOverlayTwo}{Cat#1OverlayTwo}%
    \colorlet{SlidemintOverlayOne}{Cat#1OverlayOne}%
    \colorlet{SlidemintOverlayZero}{Cat#1OverlayZero}%
    \colorlet{SlidemintSurfaceTwo}{Cat#1SurfaceTwo}%
    \colorlet{SlidemintSurfaceOne}{Cat#1SurfaceOne}%
    \colorlet{SlidemintSurfaceZero}{Cat#1SurfaceZero}%
    \colorlet{SlidemintBase}{Cat#1Base}%
    \colorlet{SlidemintPanel}{Cat#1Mantle}%
    \colorlet{SlidemintCrust}{Cat#1Crust}%
    \colorlet{SlidemintSurface}{Cat#1Mantle}%
    \colorlet{SlidemintAccent}{Cat#1Lavender}%
    \colorlet{SlidemintHeading}{Cat#1Lavender}%
    \colorlet{SlidemintListMarker}{Cat#1Sapphire}%
    \colorlet{SlidemintStrong}{Cat#1Sapphire}%
    \colorlet{SlidemintEmphasis}{Cat#1Green}%
    \colorlet{SlidemintStrongEmphasis}{Cat#1Teal}%
    \colorlet{SlidemintLink}{Cat#1Blue}%
    \colorlet{SlidemintExternalLink}{Cat#1Teal}%
    \colorlet{SlidemintOnAccent}{Cat#1Mantle}%
    \colorlet{SlidemintBlockTitle}{Cat#1Blue}%
    \colorlet{SlidemintBlockBody}{Cat#1Blue!10!Cat#1Base}%
    \colorlet{SlidemintAlertTitle}{Cat#1Red}%
    \colorlet{SlidemintAlertBody}{Cat#1Red!10!Cat#1Base}%
    \colorlet{SlidemintExampleTitle}{Cat#1Mauve}%
    \colorlet{SlidemintExampleBody}{Cat#1Mauve!10!Cat#1Base}%
    \colorlet{SlidemintCodeBody}{Cat#1Base}%
    \colorlet{SlidemintRibbonBody}{Cat#1Mantle}%
}

\newcommand*{\SlidemintApplyBeamerColors}{%
    \mode<presentation>%
    \setbeamercolor{frametitle}{bg=SlidemintBase,fg=SlidemintHeading}%
    \setbeamercolor{frametitle right}{bg=SlidemintBase}%
    \setbeamercolor{framesubtitle}{bg=SlidemintBase,fg=SlidemintSubtext}%
    \setbeamercolor{footline}{fg=SlidemintHeading,bg=SlidemintBase}%
    \setbeamercolor{title in head/foot}{parent=footline}%
    \setbeamercolor{author in head/foot}{parent=footline}%
    \setbeamercolor{date in head/foot}{parent=footline}%
    \setbeamercolor{page number in head/foot}{fg=SlidemintHeading,bg=SlidemintSurfaceZero}%
    \setbeamercolor{normal text}{fg=SlidemintText,bg=SlidemintBase}%
    \setbeamercolor{titlelike}{parent=structure}%
    \setbeamercolor{item}{fg=SlidemintAccent}%
    \setbeamercolor{itemize item}{fg=SlidemintListMarker}%
    \setbeamercolor{itemize subitem}{fg=SlidemintListMarker}%
    \setbeamercolor{itemize subsubitem}{fg=SlidemintListMarker}%
    \setbeamercolor{enumerate item}{fg=SlidemintListMarker}%
    \setbeamercolor{enumerate subitem}{fg=SlidemintListMarker}%
    \setbeamercolor{enumerate subsubitem}{fg=SlidemintListMarker}%
    \setbeamercolor{item projected}{fg=SlidemintOnAccent,bg=SlidemintAccent}%
    \setbeamercolor{description item}{fg=SlidemintListMarker,bg=}%
    \setbeamercolor{structure}{fg=SlidemintAccent,bg=}%
    \setbeamercolor{alerted text}{fg=SlidemintAlertTitle}%
    \setbeamercolor{block title}{fg=SlidemintBlockTitle,bg=SlidemintBlockBody}%
    \setbeamercolor{block body}{fg=SlidemintText,bg=SlidemintBlockBody}%
    \setbeamercolor{block title alerted}{fg=SlidemintAlertTitle,bg=SlidemintAlertBody}%
    \setbeamercolor{block body alerted}{fg=SlidemintText,bg=SlidemintAlertBody}%
    \setbeamercolor{block title example}{fg=SlidemintExampleTitle,bg=SlidemintExampleBody}%
    \setbeamercolor{block body example}{fg=SlidemintText,bg=SlidemintExampleBody}%
    \setbeamercolor{ribbon}{fg=SlidemintText,bg=SlidemintRibbonBody}%
    \setbeamercolor{ribbon structure}{fg=SlidemintAccent}%
    \setbeamercolor{ribbon item}{fg=SlidemintAccent}%
    \setbeamercolor{ribbon item projected}{fg=SlidemintOnAccent,bg=SlidemintAccent}%
    \setbeamercolor{ribbon alerted text}{fg=SlidemintAlertTitle}%
    \setbeamercolor{code block}{fg=SlidemintText,bg=SlidemintCodeBody}%
    \setbeamercolor{bibliography item}{fg=SlidemintMuted,bg=}%
    \setbeamercolor{bibliography entry author}{fg=SlidemintText,bg=}%
    \setbeamercolor{bibliography entry title}{fg=SlidemintText,bg=}%
    \setbeamercolor{bibliography entry location}{fg=SlidemintSubtext,bg=}%
    \setbeamercolor{bibliography entry note}{fg=SlidemintMuted,bg=}%
    \setbeamercolor{title}{fg=SlidemintHeading,bg=}%
    \setbeamercolor{subtitle}{fg=SlidemintSubtext,bg=}%
    \setbeamercolor{author}{fg=SlidemintSubtext,bg=}%
    \setbeamercolor{date}{fg=SlidemintSubtext,bg=}%
    \setbeamercolor{institute}{fg=SlidemintSubtext,bg=}%
    \setbeamercolor{titlegraphic}{fg=SlidemintSubtext,bg=}%
    \arrayrulecolor{SlidemintAccent}%
    \mode<all>%
}

\newcommand*{\SlidemintLatteColors}{%
    \SlidemintDarkModefalse%
    \SlidemintUsePalette{Latte}%
    \SlidemintApplyBeamerColors%
}

\newcommand*{\SlidemintFrappeColors}{%
    \SlidemintDarkModetrue%
    \SlidemintUsePalette{Frappe}%
    \SlidemintApplyBeamerColors%
}

\newcommand*{\SlidemintMacchiatoColors}{%
    \SlidemintDarkModetrue%
    \SlidemintUsePalette{Macchiato}%
    \SlidemintApplyBeamerColors%
}

\newcommand*{\SlidemintMochaColors}{%
    \SlidemintDarkModetrue%
    \SlidemintUsePalette{Mocha}%
    \SlidemintApplyBeamerColors%
}

\SlidemintLatteColors%
