\RequirePackage{tikz}

\newenvironment{ribbon}{\usebeamertemplate{ribbon begin}}{\usebeamertemplate{ribbon end}}
\newcommand*{\AcademicListBullet}{%
    \tikz[baseline=-0.55ex]{\fill[AcademicListMarker] (0,0) circle[radius=0.15em];}%
}

\mode<presentation>

\setbeamertemplate{itemize item}{\AcademicListBullet}
\setbeamertemplate{itemize subitem}{\AcademicListBullet}
\setbeamertemplate{itemize subsubitem}{\AcademicListBullet}

\setbeamertemplate{enumerate item}{\textcolor{AcademicListMarker}{\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{\textcolor{AcademicListMarker}{\insertsubenumlabel.}}
\setbeamertemplate{enumerate subsubitem}{\textcolor{AcademicListMarker}{\insertsubsubenumlabel.}}


\setbeamertemplate{bibliography item}[triangle]

\setbeamertemplate{ribbon begin}{%
    \vspace{.3em}
    \vbox{}
    \begin{beamercolorbox}[wd=\paperwidth,colsep*=.3em,center]{ribbon}%
        \setbeamercolor{structure}{parent=ribbon structure}%
        \setbeamercolor*{item}{parent=ribbon item}%
        \setbeamercolor*{item projected}{parent=ribbon item projected}%
        \setbeamercolor*{alerted text}{parent=ribbon alerted text}%
        \begin{minipage}{1.0\textwidth}\noindent%
            }
            \setbeamertemplate{ribbon end}{%
        \end{minipage}%
    \end{beamercolorbox}%
}

\newcommand*{\AcademicTitleGraphic}{%
    \node[anchor=west,xshift=-3mm] at (current page.west) {%
        \ifAcademicDarkMode
            \includegraphics[height=\paperheight]{graphics/title-graphic-light.pdf}%
        \else
            \includegraphics[height=\paperheight]{graphics/title-graphic-color.pdf}%
        \fi
    };%
}

\defbeamertemplate*{section page}{catppuccinacademic}
{
    \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=center] at (current page.center) {%
            \begin{minipage}{\textwidth}%
                \centering
                {\usebeamerfont{title}%
                \hypersetup{linkcolor=AcademicHeading}\textcolor{AcademicHeading}{\insertsection}}\par
            \end{minipage}%
        };
    \end{tikzpicture}
}

\defbeamertemplate*{title page}{catppuccinacademic}[1][]
{
    \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=south,yshift=-0.2 * 0.1327 * \paperwidth] (footer image) at (current page.south) {};
        \AcademicTitleGraphic
        \node[anchor=center,xshift=.1\paperwidth] at (current page.center) {%
            \begin{minipage}[c][\dimexpr\paperheight-0.1062\paperwidth-2em\relax][c]{\textwidth}
                \centering
                {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
                \ifx\insertsubtitle\@empty%
                \else%
                    \vskip0.25em%
                    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
                \fi%
                \ifx\insertauthor\@empty%
                \else%
                    \vskip.5em\par
                    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
                \fi%
                \ifx\insertinstitute\@empty%
                \else%
                    \vskip.5em\par
                    {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}%
                    \vskip.3em\par
                \fi%
                \vskip.5em\par
                {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
                \vfill
            \end{minipage}
        };
        \node[anchor=north east,yshift=-3mm, xshift=-5mm] at (current page.north east) {%
            \ifAcademicDarkMode
                \includegraphics[width=2.5cm]{graphics/affiliation-logo-light.pdf}%
            \else
                \includegraphics[width=2.5cm]{graphics/affiliation-logo-color.pdf}%
            \fi
        };
        \node[anchor=south east,yshift=3mm, xshift=-3mm] at (current page.south east)
        {%
            \ifAcademicDarkMode
                \includegraphics[width=8cm]{graphics/collaboration-logo-light.pdf}%
            \else
                \includegraphics[width=8cm]{graphics/collaboration-logo-color.pdf}%
            \fi
        };
    \end{tikzpicture}
}

\mode<all>
