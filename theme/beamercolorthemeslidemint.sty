\newcommand*{\AcademicUsePalette}[1]{%
    \colorlet{AcademicRosewater}{Cat#1Rosewater}%
    \colorlet{AcademicFlamingo}{Cat#1Flamingo}%
    \colorlet{AcademicPink}{Cat#1Pink}%
    \colorlet{AcademicMauve}{Cat#1Mauve}%
    \colorlet{AcademicRed}{Cat#1Red}%
    \colorlet{AcademicMaroon}{Cat#1Maroon}%
    \colorlet{AcademicPeach}{Cat#1Peach}%
    \colorlet{AcademicYellow}{Cat#1Yellow}%
    \colorlet{AcademicGreen}{Cat#1Green}%
    \colorlet{AcademicTeal}{Cat#1Teal}%
    \colorlet{AcademicSky}{Cat#1Sky}%
    \colorlet{AcademicSapphire}{Cat#1Sapphire}%
    \colorlet{AcademicBlue}{Cat#1Blue}%
    \colorlet{AcademicLavender}{Cat#1Lavender}%
    \colorlet{AcademicText}{Cat#1Text}%
    \colorlet{AcademicSubtext}{Cat#1SubtextOne}%
    \colorlet{AcademicMuted}{Cat#1SubtextZero}%
    \colorlet{AcademicOverlayTwo}{Cat#1OverlayTwo}%
    \colorlet{AcademicOverlayOne}{Cat#1OverlayOne}%
    \colorlet{AcademicOverlayZero}{Cat#1OverlayZero}%
    \colorlet{AcademicSurfaceTwo}{Cat#1SurfaceTwo}%
    \colorlet{AcademicSurfaceOne}{Cat#1SurfaceOne}%
    \colorlet{AcademicSurfaceZero}{Cat#1SurfaceZero}%
    \colorlet{AcademicBase}{Cat#1Base}%
    \colorlet{AcademicPanel}{Cat#1Mantle}%
    \colorlet{AcademicCrust}{Cat#1Crust}%
    \colorlet{AcademicSurface}{Cat#1Mantle}%
    \colorlet{AcademicAccent}{Cat#1Lavender}%
    \colorlet{AcademicHeading}{Cat#1Lavender}%
    \colorlet{AcademicListMarker}{Cat#1Sapphire}%
    \colorlet{AcademicStrong}{Cat#1Sapphire}%
    \colorlet{AcademicEmphasis}{Cat#1Green}%
    \colorlet{AcademicStrongEmphasis}{Cat#1Teal}%
    \colorlet{AcademicLink}{Cat#1Blue}%
    \colorlet{AcademicExternalLink}{Cat#1Teal}%
    \colorlet{AcademicOnAccent}{Cat#1Mantle}%
    \colorlet{AcademicBlockTitle}{Cat#1Blue}%
    \colorlet{AcademicBlockBody}{Cat#1Blue!10!Cat#1Base}%
    \colorlet{AcademicAlertTitle}{Cat#1Red}%
    \colorlet{AcademicAlertBody}{Cat#1Red!10!Cat#1Base}%
    \colorlet{AcademicExampleTitle}{Cat#1Mauve}%
    \colorlet{AcademicExampleBody}{Cat#1Mauve!10!Cat#1Base}%
    \colorlet{AcademicCodeBody}{Cat#1Base}%
    \colorlet{AcademicRibbonBody}{Cat#1Mantle}%
    \colorlet{AcademicKeyword}{Cat#1Mauve}%
    \colorlet{AcademicFunction}{Cat#1Blue}%
    \colorlet{AcademicType}{Cat#1Yellow}%
    \colorlet{AcademicParameter}{Cat#1Maroon}%
    \colorlet{AcademicOperator}{Cat#1Teal}%
    \colorlet{AcademicPunctuation}{Cat#1Teal}%
    \colorlet{AcademicString}{Cat#1Green}%
}

\newcommand*{\AcademicApplyBeamerColors}{%
    \mode<presentation>%
    \setbeamercolor{frametitle}{bg=AcademicBase,fg=AcademicHeading}%
    \setbeamercolor{frametitle right}{bg=AcademicBase}%
    \setbeamercolor{framesubtitle}{bg=AcademicBase,fg=AcademicSubtext}%
    \setbeamercolor{footline}{fg=AcademicMuted,bg=AcademicBase}%
    \setbeamercolor{title in head/foot}{parent=footline}%
    \setbeamercolor{author in head/foot}{parent=footline}%
    \setbeamercolor{date in head/foot}{parent=footline}%
    \setbeamercolor{page number in head/foot}{fg=AcademicText,bg=AcademicSurfaceZero}%
    \setbeamercolor{normal text}{fg=AcademicText,bg=AcademicBase}%
    \setbeamercolor{titlelike}{parent=structure}%
    \setbeamercolor{item}{fg=AcademicAccent}%
    \setbeamercolor{itemize item}{fg=AcademicListMarker}%
    \setbeamercolor{itemize subitem}{fg=AcademicListMarker}%
    \setbeamercolor{itemize subsubitem}{fg=AcademicListMarker}%
    \setbeamercolor{enumerate item}{fg=AcademicListMarker}%
    \setbeamercolor{enumerate subitem}{fg=AcademicListMarker}%
    \setbeamercolor{enumerate subsubitem}{fg=AcademicListMarker}%
    \setbeamercolor{item projected}{fg=AcademicOnAccent,bg=AcademicAccent}%
    \setbeamercolor{description item}{parent=alerted text}%
    \setbeamercolor{structure}{fg=AcademicAccent,bg=}%
    \setbeamercolor{alerted text}{fg=AcademicAlertTitle}%
    \setbeamercolor{block title}{fg=AcademicBlockTitle,bg=AcademicBlockBody}%
    \setbeamercolor{block body}{fg=AcademicText,bg=AcademicBlockBody}%
    \setbeamercolor{block title alerted}{fg=AcademicAlertTitle,bg=AcademicAlertBody}%
    \setbeamercolor{block body alerted}{fg=AcademicText,bg=AcademicAlertBody}%
    \setbeamercolor{block title example}{fg=AcademicExampleTitle,bg=AcademicExampleBody}%
    \setbeamercolor{block body example}{fg=AcademicText,bg=AcademicExampleBody}%
    \setbeamercolor{ribbon}{fg=AcademicText,bg=AcademicRibbonBody}%
    \setbeamercolor{ribbon structure}{fg=AcademicAccent}%
    \setbeamercolor{ribbon item}{fg=AcademicAccent}%
    \setbeamercolor{ribbon item projected}{fg=AcademicOnAccent,bg=AcademicAccent}%
    \setbeamercolor{ribbon alerted text}{fg=AcademicAlertTitle}%
    \setbeamercolor{code block}{fg=AcademicText,bg=AcademicCodeBody}%
    \setbeamercolor{title}{fg=AcademicHeading,bg=}%
    \setbeamercolor{subtitle}{fg=AcademicSubtext,bg=}%
    \setbeamercolor{author}{fg=AcademicSubtext,bg=}%
    \setbeamercolor{date}{fg=AcademicSubtext,bg=}%
    \setbeamercolor{institute}{fg=AcademicSubtext,bg=}%
    \arrayrulecolor{AcademicAccent}%
    \mode<all>%
}

\newcommand*{\lattecolors}{%
    \AcademicDarkModefalse%
    \AcademicUsePalette{Latte}%
    \AcademicApplyBeamerColors%
}

\newcommand*{\frappecolors}{%
    \AcademicDarkModetrue%
    \AcademicUsePalette{Frappe}%
    \AcademicApplyBeamerColors%
    \setbeamercolor{footline}{fg=white,bg=AcademicBase}%
}

\newcommand*{\macchiatocolors}{%
    \AcademicDarkModetrue%
    \AcademicUsePalette{Macchiato}%
    \AcademicApplyBeamerColors%
    \setbeamercolor{footline}{fg=white,bg=AcademicBase}%
}

\newcommand*{\mochacolors}{%
    \AcademicDarkModetrue%
    \AcademicUsePalette{Mocha}%
    \AcademicApplyBeamerColors%
    \setbeamercolor{footline}{fg=white,bg=AcademicBase}%
}

\newcommand*{\darkcolors}{%
    \frappecolors%
}

