\RequirePackage{iftex}

\newcommand*{\SlidemintUseMathDigitFont}{%
    \DeclareSymbolFont{slidemintmathdigits}{\encodingdefault}{\familydefault}{\mddefault}{\updefault}%
    \DeclareMathSymbol{0}{\mathord}{slidemintmathdigits}{`0}%
    \DeclareMathSymbol{1}{\mathord}{slidemintmathdigits}{`1}%
    \DeclareMathSymbol{2}{\mathord}{slidemintmathdigits}{`2}%
    \DeclareMathSymbol{3}{\mathord}{slidemintmathdigits}{`3}%
    \DeclareMathSymbol{4}{\mathord}{slidemintmathdigits}{`4}%
    \DeclareMathSymbol{5}{\mathord}{slidemintmathdigits}{`5}%
    \DeclareMathSymbol{6}{\mathord}{slidemintmathdigits}{`6}%
    \DeclareMathSymbol{7}{\mathord}{slidemintmathdigits}{`7}%
    \DeclareMathSymbol{8}{\mathord}{slidemintmathdigits}{`8}%
    \DeclareMathSymbol{9}{\mathord}{slidemintmathdigits}{`9}%
}

\newcommand*{\SlidemintUseLuaFonts}{%
    \RequirePackage{fontspec}%
    \newfontfamily{\titlefont}[Scale=MatchUppercase]{Plus Jakarta Sans}%
    \setmainfont[
        ItalicFont={Roboto Condensed Light Italic},
        BoldFont={Roboto Condensed},
        BoldItalicFont={Roboto Condensed Italic},
        Ligatures=TeX,
    ]{Roboto Condensed Light}%
    \setsansfont[
        ItalicFont={Roboto Condensed Light Italic},
        BoldFont={Roboto Condensed},
        BoldItalicFont={Roboto Condensed Italic},
        Ligatures=TeX,
    ]{Roboto Condensed Light}%
    \setmonofont[
        ItalicFont={MesloLGS NF Italic},
        Ligatures=NoCommon,
        Scale=MatchLowercase,
    ]{MesloLGS NF}%
    \newfontfamily{\SlidemintCodeFontFamily}[Ligatures=NoCommon]{MesloLGS NF}%
    \newfontfamily{\quotefont}[
        Weight=500,
        ItalicFont={Plus Jakarta Sans Italic},
        ItalicFeatures={Weight=500},
    ]{Plus Jakarta Sans}%
    \AtBeginDocument{\SlidemintUseMathDigitFont}%
}

\newcommand*{\SlidemintUseXeFonts}{%
    \RequirePackage{mathspec}%
    \newfontfamily{\titlefont}[Scale=MatchUppercase]{PlusJakartaSans-VariableFont_wght.ttf}%
    \setallmainfonts(Digits)[
        ItalicFont=RobotoCondensed-LightItalic.otf,
        BoldFont=RobotoCondensed-Regular.otf,
        BoldItalicFont=RobotoCondensed-Italic.otf,
        Ligatures=TeX,
    ]{RobotoCondensed-Light.otf}%
    \setallsansfonts[
        ItalicFont=RobotoCondensed-LightItalic.otf,
        BoldFont=RobotoCondensed-Regular.otf,
        BoldItalicFont=RobotoCondensed-Italic.otf,
        Ligatures=TeX,
    ]{RobotoCondensed-Light.otf}%
    \setallmonofonts[
        ItalicFont={MesloLGS NF Italic.ttf},
        Ligatures=NoCommon,
        Scale=MatchLowercase,
    ]{MesloLGS NF Regular.ttf}%
    \newfontfamily{\SlidemintCodeFontFamily}[
        ItalicFont={MesloLGS NF Italic.ttf},
        Ligatures=NoCommon,
    ]{MesloLGS NF Regular.ttf}%
    \newfontfamily{\quotefont}[
        Weight=500,
        ItalicFont={PlusJakartaSans-Italic-VariableFont_wght.ttf},
        ItalicFeatures={Weight=500},
    ]{PlusJakartaSans-VariableFont_wght.ttf}%
}

\newcommand*{\SlidemintUsePdfFonts}{%
    \RequirePackage[T1]{fontenc}%
    \RequirePackage[sfdefault,light,condensed]{roboto}%
    \newcommand{\titlefont}{\sffamily}%
    \newcommand{\SlidemintCodeFontFamily}{%
        \PackageError{slidemint}{VSCode Catppuccin code blocks require LuaLaTeX or XeLaTeX}{Use LuaLaTeX or XeLaTeX.}%
    }%
    \newcommand{\quotefont}{\sffamily}%
}

\ifLuaTeX%
    \SlidemintUseLuaFonts%
\else\ifXeTeX%
        \SlidemintUseXeFonts%
    \else
        \SlidemintUsePdfFonts%
    \fi\fi

\newcommand*{\SlidemintCodeFont}{\SlidemintCodeFontFamily\fontsize{9.75pt}{15pt}\selectfont}

\setbeamerfont{title}{family=\titlefont,series=\mdseries}
\setbeamerfont{subtitle}{parent=title,series=\mdseries}
\setbeamerfont{author}{parent=subtitle,series=\mdseries}
\setbeamerfont{institute}{parent=subtitle,series=\mdseries}
\setbeamerfont{date}{parent=subtitle,series=\mdseries}

%%%%%%%%%%%%%%%
% Inner Theme %
%%%%%%%%%%%%%%%

% Block Environments
\setbeamerfont{block body}{}
\setbeamerfont{block body alerted}{parent=block body}
\setbeamerfont{block body example}{parent=block body}
\setbeamerfont{block title}{size=\normalsize,parent={structure,block body}}
\setbeamerfont{block title alerted}{parent={block title,alerted text}}
\setbeamerfont{block title example}{parent={block title,example text}}

% Verse, Quotations, Quotes
\setbeamerfont{quotation}{family=\quotefont}
\setbeamerfont{quote}{family=\quotefont}
